<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>All Entries</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1> All Enties</h1>
 <% entries.forEach(entry => { %>
        <h2><%= entry.title %></h2>
        <p><%= entry.entryBody %></p>

        <% if (user && entry.owner.equals(user._id)) { %>
            <button>Edit</button>
            <button>Delete</button>
        <% } %>
    <% }) %>

    </body>
</html>